# Dokploy environment variables for ownchagpt (LibreChat)
# Copy these values into the Environment tab of your Dokploy Docker Compose project.
# Every secret below must be set before deploying. Change them to your own values.
#
# NOTE: all changes to these env vars require a Redeploy (they are baked into
# the running containers, not read from this file at runtime).

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# Public URL users access the app from (set this to YOUR real domain)
DOMAIN_CLIENT=https://chat.sitenexai.com
DOMAIN_SERVER=https://chat.sitenexai.com

# REQUIRED in production: comma-separated list of browser origins allowed to call
# the API. MUST include the admin panel origin too, because the panel (hosted on
# its own domain) calls the API from a different origin than the chat client.
# The server does NOT start if this is empty.
ALLOWED_ORIGINS=https://chat.sitenexai.com, https://admin.sitenexai.com

# Traefik router hostnames (used by the compose labels). These MUST match the
# domains you point at the VPS, otherwise Traefik returns an error on the domain.
API_DOMAIN=chat.sitenexai.com
ADMIN_DOMAIN=admin.sitenexai.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string for the MongoDB app deployed separately in Dokploy
# (e.g. mongodb://<user>:<pass>@<app-hostname>:27017/?authSource=admin&directConnection=true).
# The api service is attached to the shared "dokploy-network" so it can resolve
# the <app-hostname> that Dokploy shows for the database app.
MONGO_URI=mongodb://mongodb:cc7ILFYAPr89oBi2jNbR@ownchatgpt-mongodb-o65fmy:27017/?authSource=admin&directConnection=true

# ---------------------------------------------------------------------------
# Secrets (generate your own!)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_32_BYTE_HEX
ADMIN_PANEL_SESSION_SECRET=REPLACE_WITH_32_BYTE_HEX
# CREDS_KEY must be 32 bytes hex (64 chars), CREDS_IV 16 bytes hex (32 chars).
# Generate with: openssl rand -hex 32  and  openssl rand -hex 16
CREDS_KEY=REPLACE_WITH_64_CHAR_HEX
CREDS_IV=REPLACE_WITH_32_CHAR_HEX
# Meilisearch master key (must be at least 16 bytes long).
MEILI_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_KEY

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Port for the admin panel published on the host (default 3041)
ADMIN_PANEL_PORT=3041
# Set to false if you access the admin panel over plain HTTP while testing.
ADMIN_PANEL_SESSION_COOKIE_SECURE=true
