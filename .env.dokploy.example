# Dokploy environment variables for ownchagpt (LibreChat)
# Copy these values into the Environment tab of your Dokploy Docker Compose project.
# Every secret below must be set before deploying. Change them to your own values.
#
# NOTE: all changes to these env vars require a Redeploy (they are baked into
# the running containers, not read from this file at runtime).

# ---------------------------------------------------------------------------
# Domains
# ---------------------------------------------------------------------------
# Public URL users access the app from (this must be the real domain you point
# at the VPS, e.g. https://chat.example.com)
DOMAIN_CLIENT=https://chat.yourdomain.com
DOMAIN_SERVER=https://chat.yourdomain.com

# REQUIRED in production: comma-separated list of browser origins allowed to call
# the API (the client domain and, if you expose it, the admin panel origin).
ALLOWED_ORIGINS=https://chat.yourdomain.com,https://admin.yourdomain.com

# Traefik router hostnames (used by the compose labels)
API_DOMAIN=chat.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# ---------------------------------------------------------------------------
# Secrets (generate your own!)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_32_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_32_BYTE_HEX
ADMIN_PANEL_SESSION_SECRET=REPLACE_WITH_32_BYTE_HEX
# CREDS_KEY must be 32 bytes hex (64 chars), CREDS_IV 16 bytes hex (32 chars).
# Generate with: openssl rand -hex 32  and  openssl rand -hex 16
CREDS_KEY=REPLACE_WITH_64_CHAR_HEX
CREDS_IV=REPLACE_WITH_32_CHAR_HEX
# Meilisearch master key (must be at least 16 bytes long).
MEILI_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_KEY

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Port for the admin panel published on the host (default 3001)
ADMIN_PANEL_PORT=3001
# Set to false if you access the admin panel over plain HTTP while testing.
ADMIN_PANEL_SESSION_COOKIE_SECURE=true
